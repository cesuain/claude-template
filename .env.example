# Copy to .env (never commit .env). Placeholders only.

# --- Database (Prisma) ---
# Pooled connection (Supavisor/pgbouncer, port 6543) used at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used by `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server only, never NEXT_PUBLIC_

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
SENTRY_AUTH_TOKEN="<sentry-auth-token>"           # source map upload in CI

# --- MCP servers (.mcp.json expands these from your shell env) ---
STORYBOOK_MCP_URL="http://localhost:6006/mcp"
POSTMAN_API_KEY="<postman-api-key>"
# Read-only Postgres role for the postgres MCP (GRANT SELECT only)
DATABASE_URL_READONLY="postgresql://readonly_mcp:<password>@<host>:5432/postgres"
SUPABASE_PROJECT_REF="<project-ref>"
